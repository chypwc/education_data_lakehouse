{
    "name": "education_analysis_pipeline",
    "properties": {
        "activities": [
            {
                "name": "foreach_copy_bronze_csv",
                "description": "copy_bronze_file_to_table",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "bronze_prepare_batch_load",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@if(\n    equals(pipeline().parameters.load_mode, 'INITIAL_SNAPSHOT'),\n    createArray(\n        json('{\"file_name\":\"schools.csv\",\"table_name\":\"schools\"}'),\n        json('{\"file_name\":\"students.csv\",\"table_name\":\"students\"}'),\n        json('{\"file_name\":\"attendance.csv\",\"table_name\":\"attendance\"}'),\n        json('{\"file_name\":\"assessment_results.csv\",\"table_name\":\"assessment_results\"}')\n    ),\n    createArray(\n        json('{\"file_name\":\"schools_delta.csv\",\"table_name\":\"schools\"}'),\n        json('{\"file_name\":\"students_delta.csv\",\"table_name\":\"students\"}'),\n        json('{\"file_name\":\"attendance.csv\",\"table_name\":\"attendance\"}'),\n        json('{\"file_name\":\"assessment_results_delta.csv\",\"table_name\":\"assessment_results\"}')\n    )\n)",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "copy_bronze_file_to_table",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "additionalColumns": [
                                        {
                                            "name": "source_batch_id",
                                            "value": {
                                                "value": "@pipeline().parameters.source_batch_id",
                                                "type": "Expression"
                                            }
                                        },
                                        {
                                            "name": "reporting_month",
                                            "value": {
                                                "value": "@pipeline().parameters.reporting_month",
                                                "type": "Expression"
                                            }
                                        },
                                        {
                                            "name": "source_file_name",
                                            "value": {
                                                "value": "@item().file_name",
                                                "type": "Expression"
                                            }
                                        }
                                    ],
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "AzureSqlSink",
                                    "writeBehavior": "insert",
                                    "sqlWriterUseTableLock": false,
                                    "disableMetricsCollection": false
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_adls_csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container_name": "education-lakehouse",
                                        "folder_path": {
                                            "value": "@concat('raw/month=', pipeline().parameters.reporting_month)",
                                            "type": "Expression"
                                        },
                                        "file_name": "@item().file_name"
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_azure_sql_table",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "schema_name": "bronze",
                                        "table_name": "@item().table_name"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "audit_record_file_load",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "copy_bronze_file_to_table",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[audit].[usp_record_file_load]",
                                "storedProcedureParameters": {
                                    "load_status": {
                                        "value": "LOADED",
                                        "type": "String"
                                    },
                                    "loaded_row_count": {
                                        "value": {
                                            "value": "@activity('copy_bronze_file_to_table').output.rowsCopied",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "pipeline_run_id": {
                                        "value": {
                                            "value": "@int(variables('pipeline_run_id'))",
                                            "type": "Expression"
                                        },
                                        "type": "Int64"
                                    },
                                    "rejected_row_count": {
                                        "value": {
                                            "value": "@sub(activity('copy_bronze_file_to_table').output.rowsRead, activity('copy_bronze_file_to_table').output.rowsCopied)",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "reporting_month": {
                                        "value": {
                                            "value": "@pipeline().parameters.reporting_month",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "source_batch_id": {
                                        "value": {
                                            "value": "@pipeline().parameters.source_batch_id",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "source_file_name": {
                                        "value": {
                                            "value": "@item().file_name",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "source_row_count": {
                                        "value": {
                                            "value": "@activity('copy_bronze_file_to_table').output.rowsRead",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "target_table_name": {
                                        "value": {
                                            "value": "@concat('bronze.', item().table_name)",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_sql_database",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            },
            {
                "name": "copy_bronze_school_events",
